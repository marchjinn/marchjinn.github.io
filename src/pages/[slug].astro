
---
import SiteLayout from "../layouts/SiteLayout.astro";
import MediaCard from "../components/MediaCard.astro";

import {
  mediaCategories,
  mediaItems,
  getMediaEmbedUrl
} from "../content/media";

import {
  musicItems
} from "../content/music";

import type {
  MediaCategory
} from "../content/media";

import type {
  MusicItem,
  MusicPlayerProvider
} from "../content/music";

type Props =
  | {
      pageType: "media-category";
      category: MediaCategory;
      item?: never;
    }
  | {
      pageType: "music-item";
      item: MusicItem;
      category?: never;
    };

export function getStaticPaths() {
  const mediaPaths = mediaCategories.map((category) => ({
    params: {
      slug: category.slug
    },
    props: {
      pageType: "media-category" as const,
      category
    }
  }));

  const publishedMusicItems = musicItems.filter(
    (item) => item.status === "published"
  );

  const musicSlugs = publishedMusicItems.map((item) => item.slug);
  const mediaSlugs = mediaCategories.map((category) => category.slug);

  const duplicateSlugs = musicSlugs.filter(
    (slug) => mediaSlugs.includes(slug)
  );

  if (duplicateSlugs.length > 0) {
    throw new Error(
      `Music and Media routes have duplicate slugs: ${duplicateSlugs.join(", ")}`
    );
  }

  const musicPaths = publishedMusicItems.map((item) => ({
    params: {
      slug: item.slug
    },
    props: {
      pageType: "music-item" as const,
      item
    }
  }));

  return [...mediaPaths, ...musicPaths];
}

const { pageType } = Astro.props as Props;

const category =
  pageType === "media-category"
    ? (Astro.props as Extract<Props, { pageType: "media-category" }>).category
    : undefined;

const item =
  pageType === "music-item"
    ? (Astro.props as Extract<Props, { pageType: "music-item" }>).item
    : undefined;

const mediaEntries = category
  ? mediaItems
      .filter(
        (mediaItem) =>
          mediaItem.category === category.slug &&
          mediaItem.status === "published"
      )
      .sort((a, b) => {
        const dateA = a.publishedAt
          ? Date.parse(a.publishedAt)
          : 0;

        const dateB = b.publishedAt
          ? Date.parse(b.publishedAt)
          : 0;

        const timestampA = Number.isFinite(dateA) ? dateA : 0;
        const timestampB = Number.isFinite(dateB) ? dateB : 0;

        return timestampB - timestampA;
      })
  : [];

if (pageType === "media-category" && !category) {
  throw new Error("Media category was not found.");
}

if (pageType === "music-item" && !item) {
  throw new Error("Music item was not found.");
}

const pageTitle = category?.title ?? item!.title;

const pageDescription = category
  ? `${category.title} — March Jinn Media.`
  : item!.description ?? `${item!.title} — March Jinn.`;

/**
 * Builds the official YouTube embedded playlist URL.
 *
 * YouTube's native embedded player handles playlist
 * navigation and track selection.
 */
function getYouTubePlaylistEmbedUrl(url?: string): string | undefined {
  if (!url) return undefined;

  try {
    const parsedUrl = new URL(url);
    const hostname = parsedUrl.hostname.toLowerCase();

    const isYouTube =
      hostname === "youtube.com" ||
      hostname.endsWith(".youtube.com") ||
      hostname === "youtube-nocookie.com" ||
      hostname.endsWith(".youtube-nocookie.com") ||
      hostname === "youtu.be";

    if (!isYouTube) return undefined;

    const playlistId = parsedUrl.searchParams.get("list");

    if (!playlistId) return undefined;

    return `https://www.youtube.com/embed?listType=playlist&list=${encodeURIComponent(playlistId)}`;
  } catch {
    return undefined;
  }
}

const playerSources = item?.playerSources ?? [];

const providerLabels: Record<MusicPlayerProvider, string> = {
  "apple-music": "Apple Music",
  spotify: "Spotify",
  "amazon-music": "Amazon Music",
  soundcloud: "SoundCloud",
  tidal: "TIDAL",
  deezer: "Deezer",
  bandcamp: "Bandcamp",
  audiomack: "Audiomack"
};

/**
 * Font Awesome 6 platform icons.
 *
 * Audiomack uses a neutral Font Awesome icon because
 * a dedicated Audiomack brand icon is not included
 * in the selected Font Awesome set.
 */
const providerIcons: Record<MusicPlayerProvider, string> = {
  "apple-music": "fa-brands fa-apple",
  spotify: "fa-brands fa-spotify",
  "amazon-music": "fa-brands fa-amazon",
  soundcloud: "fa-brands fa-soundcloud",
  tidal: "fa-brands fa-tidal",
  deezer: "fa-brands fa-deezer",
  bandcamp: "fa-brands fa-bandcamp",
  audiomack: "fa-solid fa-headphones"
};

/**
 * Resolves Font Awesome icons for external Listen On links.
 */
function getPlatformIconClass(platform: string): string {
  const normalized = platform.toLowerCase().trim();

  if (normalized.includes("apple")) {
    return "fa-brands fa-apple";
  }

  if (normalized.includes("spotify")) {
    return "fa-brands fa-spotify";
  }

  if (normalized.includes("amazon")) {
    return "fa-brands fa-amazon";
  }

  if (normalized.includes("soundcloud")) {
    return "fa-brands fa-soundcloud";
  }

  if (normalized.includes("tidal")) {
    return "fa-brands fa-tidal";
  }

  if (normalized.includes("deezer")) {
    return "fa-brands fa-deezer";
  }

  if (normalized.includes("bandcamp")) {
    return "fa-brands fa-bandcamp";
  }

  if (normalized.includes("audiomack")) {
    return "fa-solid fa-headphones";
  }

  if (normalized.includes("youtube")) {
    return "fa-brands fa-youtube";
  }

  return "fa-solid fa-music";
}

const youtubeEmbedUrl = getYouTubePlaylistEmbedUrl(
  item?.youtubePlaylistUrl
);

const releaseIsUpcoming =
  item?.releaseStatus === "upcoming";

const externalLinks = item?.externalLinks ?? [];
---

<SiteLayout
  title={pageTitle}
  description={pageDescription}
>
  {category ? (
    <section
      class="domain-page"
      data-domain-page="media"
      aria-labelledby="page-title"
    >
      <header class="domain-heading">
        <p class="eyebrow">
          March Jinn / Media / {category.section}
        </p>

        <h1 id="page-title">{category.title}</h1>
      </header>

      <section
        class="catalog-collection media-category-collection"
        data-format={category.format}
        aria-label={category.title}
      >
        {mediaEntries.length > 0 ? (
          <div class="catalog-shelf">
            <div class="catalog-shelf__track">
              {mediaEntries.map((mediaItem) => (
                <MediaCard
                  item={mediaItem}
                  embedUrl={getMediaEmbedUrl(mediaItem.sourceUrl)}
                />
              ))}
            </div>
          </div>
        ) : (
          <p class="catalog-collection__empty">
            No published items
          </p>
        )}
      </section>

      <a class="text-link media-back-link" href="/media/">
        ← All Media Categories
      </a>
    </section>
  ) : item ? (
    <section
      class="entry-page"
      data-domain-page="music"
      aria-labelledby="page-title"
    >
      <p class="eyebrow">March Jinn / Music</p>

      <h1 id="page-title">{item.title}</h1>

      {item.subtitle && (
        <p class="entry-page__subtitle">{item.subtitle}</p>
      )}

      {item.image && (
        <div class="entry-page__media">
          <img
            src={item.image}
            alt={item.title}
            loading="eager"
            decoding="async"
          />
        </div>
      )}

      {(item.releaseType || item.format || item.date) && (
        <div class="entry-page__metadata">
          {item.releaseType && <span>{item.releaseType}</span>}
          {item.format && <span>{item.format}</span>}
          {item.date && <span>{item.date}</span>}
        </div>
      )}

      {item.artists && item.artists.length > 0 && (
        <p class="entry-page__artists">
          {item.artists.join(", ")}
        </p>
      )}

      {item.description && (
        <div class="entry-page__description">
          <p>{item.description}</p>
        </div>
      )}

      <!-- Listen On: external streaming platforms -->
      {externalLinks.length > 0 && (
        <section
          class="entry-page__section listen-on"
          aria-labelledby="listen-on-title"
        >
          <h2 id="listen-on-title">Listen On</h2>

          <nav
            class="listen-on__links"
            aria-label="Listen on external platforms"
          >
            {externalLinks.map((link) => (
              <a
                class="listen-on__link"
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <i
                  class:list={[
                    "listen-on__icon",
                    getPlatformIconClass(link.platform)
                  ]}
                  aria-hidden="true"
                />
                <span>{link.platform}</span>
                <span class="listen-on__arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </nav>
        </section>
      )}

      <!-- Universal Music Player -->
      <section
        class="entry-page__section music-player"
        aria-labelledby="music-player-title"
      >
        <div class="music-player__heading">
          <h2 id="music-player-title">Listen</h2>

          {releaseIsUpcoming && (
            <span class="music-player__status">
              Coming Soon
            </span>
          )}
        </div>

        {playerSources.length > 0 ? (
          <>
            <div
              class="music-player__tabs"
              role="group"
              aria-label="Select streaming platform"
            >
              {playerSources.map((source, index) => (
                <button
                  type="button"
                  class:list={[
                    "music-player__tab",
                    index === 0 && "is-active"
                  ]}
                  data-player-tab={source.provider}
                  aria-pressed={index === 0 ? "true" : "false"}
                >
                  <i
                    class:list={[
                      "music-player__tab-icon",
                      providerIcons[source.provider]
                    ]}
                    aria-hidden="true"
                  />

                  <span class="music-player__tab-label">
                    {providerLabels[source.provider]}
                  </span>
                </button>
              ))}
            </div>

            <div class="music-player__frame">
              {playerSources.map((source, index) => (
                <div
                  class="music-player__layer"
                  data-player-layer={source.provider}
                  hidden={index !== 0}
                >
                  <iframe
                    src={source.url}
                    title={`${item.title} on ${providerLabels[source.provider]}`}
                    loading={index === 0 ? "eager" : "lazy"}
                    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                    referrerpolicy="strict-origin-when-cross-origin"
                  />
                </div>
              ))}
            </div>
          </>
        ) : (
          <div class="music-player__placeholder">
            <p>
              {releaseIsUpcoming
                ? "Streaming platforms will be available when the release is out."
                : "Streaming links will be available soon."}
            </p>
          </div>
        )}
      </section>

      <!-- YouTube Album Player -->
      <section
        class="entry-page__section youtube-album"
        aria-labelledby="youtube-album-title"
      >
        <div class="youtube-album__heading">
          <div>
            <p class="eyebrow">Official March Jinn Playlist</p>
            <h2 id="youtube-album-title">
              {item.title}
            </h2>
          </div>

          <span class="youtube-album__label">
            <i class="fa-brands fa-youtube" aria-hidden="true" />
            YouTube
          </span>
        </div>

        {youtubeEmbedUrl ? (
          <div class="youtube-album__frame">
            <iframe
              src={youtubeEmbedUrl}
              title={`${item.title} — Official Album Playlist`}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture; web-share"
              allowfullscreen
              referrerpolicy="strict-origin-when-cross-origin"
            />
          </div>
        ) : (
          <div class="youtube-album__placeholder">
            <p>
              The official YouTube album playlist will appear here.
            </p>
          </div>
        )}

        {item.youtubePlaylistUrl && (
          <a
            class="text-link youtube-album__external-link"
            href={item.youtubePlaylistUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open playlist on YouTube ↗
          </a>
        )}
      </section>

      {item.tracks && item.tracks.length > 0 && (
        <section class="entry-page__section">
          <h2>Tracklist</h2>

          <ol>
            {item.tracks.map((track) => (
              <li>
                <span>{track.title}</span>
                {track.featuredArtists && track.featuredArtists.length > 0 && (
                  <span> — {track.featuredArtists.join(", ")}</span>
                )}
                {track.duration && <span> · {track.duration}</span>}
              </li>
            ))}
          </ol>
        </section>
      )}

      {item.credits && item.credits.length > 0 && (
        <section class="entry-page__section">
          <h2>Credits</h2>

          <ul>
            {item.credits.map((credit) => (
              <li>
                <span>{credit.name}</span>
                <span> — {credit.role}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {item.events && item.events.length > 0 && (
        <section class="entry-page__section">
          <h2>Events</h2>

          <ul>
            {item.events.map((event) => (
              <li>
                {[
                  event.date,
                  event.endDate,
                  event.venue,
                  event.city,
                  event.country
                ].filter(Boolean).join(" · ")}
              </li>
            ))}
          </ul>
        </section>
      )}
    </section>
  ) : null}
</SiteLayout>

<script>
  function initializeMusicPlayers() {
    const playerSections = document.querySelectorAll<HTMLElement>(
      ".music-player"
    );

    playerSections.forEach((section) => {
      if (section.dataset.initialized === "true") return;

      section.dataset.initialized = "true";

      const tabs = Array.from(
        section.querySelectorAll<HTMLButtonElement>("[data-player-tab]")
      );

      const layers = Array.from(
        section.querySelectorAll<HTMLElement>("[data-player-layer]")
      );

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const selectedProvider = tab.dataset.playerTab;

          tabs.forEach((item) => {
            const active = item === tab;

            item.classList.toggle("is-active", active);
            item.setAttribute("aria-pressed", String(active));
          });

          layers.forEach((layer) => {
            layer.hidden =
              layer.dataset.playerLayer !== selectedProvider;
          });

          tab.scrollIntoView({
            behavior: "smooth",
            block: "nearest",
            inline: "center"
          });
        });
      });
    });
  }

  document.addEventListener(
    "astro:page-load",
    initializeMusicPlayers
  );

  initializeMusicPlayers();
</script>

<style>
  @import url("https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css");

  .media-category-collection {
    margin-top: clamp(72px, 10vw, 120px);
  }

  .media-back-link {
    margin-top: 48px;
  }

  .entry-page__media {
    width: 100%;
    max-width: 960px;
    margin-top: 48px;
  }

  .entry-page__media img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .entry-page__metadata,
  .entry-page__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 24px;
  }

  .entry-page__section {
    margin-top: 64px;
  }

  .entry-page__section h2 {
    margin-bottom: 20px;
  }

  .music-player__heading,
  .youtube-album__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
  }

  .music-player__heading h2,
  .youtube-album__heading h2 {
    margin: 0;
  }

  .music-player__status,
  .youtube-album__label {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--color-text-muted, #999);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Universal Music Player tabs */

  .music-player__tabs {
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: clamp(12px, 2vw, 28px);
    width: 100%;
    margin-bottom: 20px;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  .music-player__tabs::-webkit-scrollbar {
    display: none;
  }

  .music-player__tab {
    position: relative;
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 2px 9px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-text-muted, #999);
    font: inherit;
    font-size: 12px;
    white-space: nowrap;
    cursor: pointer;
    transition: color 160ms ease;
  }

  .music-player__tab::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: currentColor;
    content: "";
    opacity: 0;
    transform: scaleX(0.5);
    transform-origin: center;
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .music-player__tab:hover {
    color: var(--color-text, #fff);
  }

  .music-player__tab.is-active {
    color: var(--color-text, #fff);
  }

  .music-player__tab.is-active::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .music-player__tab-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 17px;
    min-width: 17px;
    font-size: 15px;
    line-height: 1;
    text-align: center;
  }

  .music-player__tab-label {
    font-size: 12px;
    letter-spacing: 0.01em;
  }

  /* Player frame */

  .music-player__frame {
    position: relative;
    width: 100%;
    max-width: 960px;
    height: 500px;
    margin-inline: auto;
    overflow: hidden;
    border-radius: 12px;
    background: var(--color-surface, #111);
  }

  .music-player__layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .music-player__layer[hidden] {
    display: none;
  }

  .music-player__layer iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .music-player__placeholder,
  .youtube-album__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 180px;
    padding: 32px;
    border: 1px solid var(--color-border, #333);
    border-radius: 12px;
    background: var(--color-surface, #111);
    text-align: center;
  }

  .music-player__placeholder p,
  .youtube-album__placeholder p {
    max-width: 420px;
    margin: 0;
    color: var(--color-text-muted, #999);
    font-size: 14px;
    line-height: 1.6;
  }

  /* YouTube Album Player */

  .youtube-album__heading {
    align-items: flex-end;
  }

  .youtube-album__heading .eyebrow {
    margin-bottom: 8px;
  }

  .youtube-album__frame {
    position: relative;
    width: 100%;
    max-width: 960px;
    aspect-ratio: 16 / 9;
    margin-inline: auto;
    overflow: hidden;
    border-radius: 12px;
    background: #111;
  }

  .youtube-album__frame iframe {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .youtube-album__external-link {
    display: inline-block;
    margin-top: 16px;
  }

  /* Listen On */

  .listen-on__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
  }

  .listen-on__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-text-muted, #999);
    font-size: 13px;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .listen-on__link:hover {
    color: var(--color-text, #fff);
  }

  .listen-on__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 17px;
    min-width: 17px;
    font-size: 15px;
    line-height: 1;
    text-align: center;
  }

  .listen-on__arrow {
    font-size: 12px;
    opacity: 0.65;
  }

  @media (min-width: 1024px) {
    .music-player__tabs {
      justify-content: flex-start;
      gap: clamp(16px, 2.2vw, 32px);
    }
  }

  @media (max-width: 639px) {
    .music-player__frame {
      height: 500px;
      border-radius: 8px;
    }

    .music-player__tab {
      min-height: 42px;
    }

    .music-player__heading,
    .youtube-album__heading {
      align-items: flex-start;
    }

    .youtube-album__frame {
      border-radius: 8px;
    }

    .listen-on__links {
      gap: 14px 20px;
    }
  }
</style>
