---
import SiteLayout from "../layouts/SiteLayout.astro";
import MediaCard from "../components/MediaCard.astro";

import {
  mediaCategories,
  mediaItems,
  getMediaEmbedUrl
} from "../content/media";

export function getStaticPaths() {
  return mediaCategories.map((category) => ({
    params: {
      category: category.slug
    },
    props: {
      category
    }
  }));
}

const { category } = Astro.props;

const items = mediaItems.filter(
  (item) => item.category === category.slug
);

const format = category.format;
---

<SiteLayout
  title={category.title}
  description={`${category.title} — March Jinn Media.`}
>
  <section class="domain-page" aria-labelledby="page-title">
    <header class="domain-heading">
      <p class="eyebrow">
        March Jinn / Media / {category.section}
      </p>

      <h1 id="page-title">{category.title}</h1>
    </header>

    <section
      class="catalog-collection media-category-collection"
      data-format={format}
      aria-label={category.title}
    >
      {items.length > 0 ? (
        <div class="catalog-shelf">
          <div class="catalog-shelf__track">
            {items.map((item) => (
              <MediaCard
                item={item}
                embedUrl={getMediaEmbedUrl(item.sourceUrl)}
              />
            ))}
          </div>
        </div>
      ) : (
        <p class="catalog-collection__empty">
          No published items
        </p>
      )}
    </section>

    <a class="text-link media-back-link" href="/media/">
      ← All Media Categories
    </a>
  </section>
</SiteLayout>

<style>
  .media-category-collection {
    margin-top: clamp(72px, 10vw, 120px);
  }

  .media-back-link {
    margin-top: 48px;
  }
</style>