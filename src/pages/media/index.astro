
---
import SiteLayout from "../../layouts/SiteLayout.astro";
import CatalogSection from "../../components/CatalogSection.astro";
import { getMediaCatalogCollections } from "../../content/media";

const collections = getMediaCatalogCollections();
---

<SiteLayout
  title="Media"
  description="Videos, photos, audio, streams and publications featuring March Jinn."
>
  <section class="domain-page media-page" aria-labelledby="page-title">
    <header class="domain-heading">
      <p class="eyebrow">March Jinn / Domain 02</p>
      <h1 id="page-title">Media</h1>
    </header>

    <div class="domain-catalog">
      <CatalogSection
        title="Media"
        collections={collections}
      />
    </div>
  </section>
</SiteLayout>
