
---
import SiteLayout from "../layouts/SiteLayout.astro";
import CatalogSection from "../components/CatalogSection.astro";

import {
  getMusicCatalogCollections
} from "../content/music";

import {
  getMediaCatalogCollections
} from "../content/media";

const musicReleases = getMusicCatalogCollections("Releases");
const musicLives = getMusicCatalogCollections("Lives");
const musicCredits = getMusicCatalogCollections("Credits");

const mediaCollections = getMediaCatalogCollections();
---

<SiteLayout
  title="March Jinn"
  description="March Jinn Official Website"
>
  <div class="domain-environment">

    <section
      class="domain-panel"
      data-domain-panel="music"
      aria-labelledby="music-title"
    >
      <header class="domain-heading">
        <p class="eyebrow">March Jinn / Domain 01</p>
        <h1 id="music-title">Music</h1>
      </header>

      <div class="domain-catalog">
        <CatalogSection
          title="Releases"
          collections={musicReleases}
        />

        <CatalogSection
          title="Lives"
          collections={musicLives}
        />

        <CatalogSection
          title="Credits"
          collections={musicCredits}
        />
      </div>
    </section>

    <section
      class="domain-panel"
      data-domain-panel="media"
      aria-labelledby="media-title"
      hidden
    >
      <header class="domain-heading">
        <p class="eyebrow">March Jinn / Domain 02</p>
        <h1 id="media-title">Media</h1>
      </header>

      <div class="domain-catalog">
        {mediaCollections.map((collection) => (
          <CatalogSection
            title={collection.title}
            collections={[collection]}
          />
        ))}
      </div>
    </section>

  </div>

  <script>
    type Domain = "music" | "media";

    const SCROLL_KEYS: Record<Domain, string> = {
      music: "marchjinn-scroll-music",
      media: "marchjinn-scroll-media"
    };

    function getPanels() {
      return Array.from(
        document.querySelectorAll<HTMLElement>("[data-domain-panel]")
      );
    }

    function getNavigationItems() {
      return Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-domain]")
      );
    }

    function getActiveDomain(): Domain {
      const visiblePanel = getPanels().find(
        (panel) => !panel.hidden
      );

      return visiblePanel?.dataset.domainPanel === "media"
        ? "media"
        : "music";
    }

    function isDomain(value: unknown): value is Domain {
      return value === "music" || value === "media";
    }

    function saveScrollPosition(domain: Domain) {
      try {
        sessionStorage.setItem(
          SCROLL_KEYS[domain],
          String(window.scrollY)
        );
      } catch {
        // Scroll restoration remains optional.
      }
    }

    function getSavedScrollPosition(domain: Domain): number {
      try {
        const savedPosition = Number(
          sessionStorage.getItem(SCROLL_KEYS[domain])
        );

        return Number.isFinite(savedPosition) && savedPosition > 0
          ? savedPosition
          : 0;
      } catch {
        return 0;
      }
    }

    function restoreScrollPosition(domain: Domain) {
      const savedPosition = getSavedScrollPosition(domain);

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          window.scrollTo({
            top: savedPosition,
            left: 0,
            behavior: "instant"
          });
        });
      });
    }

    function renderDomain(domain: Domain) {
      const panels = getPanels();

      const target = panels.find(
        (panel) => panel.dataset.domainPanel === domain
      );

      if (!target) return;

      panels.forEach((panel) => {
        panel.hidden = panel !== target;
      });

      getNavigationItems().forEach((button) => {
        const active = button.dataset.domain === domain;

        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });

      document.title =
        domain === "music"
          ? "March Jinn"
          : "Media — March Jinn";
    }

    function selectDomain(
      domain: Domain,
      updateHistory = true
    ) {
      if (!getPanels().some(
        (panel) => panel.dataset.domainPanel === domain
      )) {
        return;
      }

      const currentDomain = getActiveDomain();

      if (currentDomain === domain) return;

      // Save the outgoing domain before hiding it.
      saveScrollPosition(currentDomain);

      renderDomain(domain);

      try {
        localStorage.setItem("marchjinn-domain", domain);
      } catch {
        // The website remains functional without local storage.
      }

      if (updateHistory) {
        history.pushState(
          { ...history.state, domain },
          "",
          window.location.pathname
        );
      }

      // Restore the destination domain's independent position.
      restoreScrollPosition(domain);
    }

    function initializeDomain() {
      const panels = getPanels();

      if (
        panels.length === 0 ||
        window.location.pathname !== "/"
      ) {
        return;
      }

      let initialDomain: unknown = "music";

      try {
        initialDomain =
          history.state?.domain ||
          localStorage.getItem("marchjinn-domain") ||
          "music";
      } catch {
        initialDomain = history.state?.domain || "music";
      }

      if (!isDomain(initialDomain)) {
        initialDomain = "music";
      }

      renderDomain(initialDomain);

      history.replaceState(
        { ...history.state, domain: initialDomain },
        "",
        window.location.pathname
      );

      restoreScrollPosition(initialDomain);
    }

    // Save the active domain's position while the user scrolls.
    window.addEventListener(
      "scroll",
      () => {
        if (window.location.pathname !== "/") return;

        saveScrollPosition(getActiveDomain());
      },
      { passive: true }
    );

    // Save once more when leaving the page.
    window.addEventListener("pagehide", () => {
      if (window.location.pathname !== "/") return;

      saveScrollPosition(getActiveDomain());
    });

    window.addEventListener("marchjinn:domain-change", (event) => {
      const customEvent = event as CustomEvent<{ domain: string }>;
      const domain = customEvent.detail.domain;

      if (isDomain(domain)) {
        selectDomain(domain);
      }
    });

    window.addEventListener("popstate", (event) => {
      let fallbackDomain: unknown = "music";

      try {
        fallbackDomain =
          localStorage.getItem("marchjinn-domain") || "music";
      } catch {
        // Use Music as the default domain.
      }

      const domain = isDomain(event.state?.domain)
        ? event.state.domain
        : isDomain(fallbackDomain)
          ? fallbackDomain
          : "music";

      selectDomain(domain, false);
    });

    document.addEventListener(
      "astro:page-load",
      initializeDomain
    );

    initializeDomain();
  </script>
</SiteLayout>
