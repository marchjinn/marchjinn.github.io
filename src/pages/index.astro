---
import SiteLayout from "../layouts/SiteLayout.astro";
import CatalogSection from "../components/CatalogSection.astro";
import MediaCatalogNavigation from "../components/MediaCatalogNavigation.astro";

const musicSections = [
  {
    title: "Releases",
    collections: [
      { title: "Albums", format: "square" },
      { title: "Singles", format: "square" },
      { title: "Appears On", format: "square" }
    ]
  },
  {
    title: "Lives",
    collections: [
      { title: "Tours", format: "wide" },
      { title: "Festivals", format: "wide" },
      { title: "Specials", format: "wide" }
    ]
  },
  {
    title: "Credits",
    collections: [
      { title: "Artist", format: "square" },
      { title: "Producer", format: "square" },
      { title: "Other", format: "square" }
    ]
  }
];
---

<SiteLayout
  title="March Jinn"
  description="March Jinn Official Website"
>
  <div class="domain-environment">

    <section
      class="domain-panel"
      data-domain-panel="music"
      aria-labelledby="music-title"
    >
      <header class="domain-heading">
        <p class="eyebrow">March Jinn / Domain 01</p>
        <h1 id="music-title">Music</h1>
      </header>

      <div class="domain-catalog">
        {musicSections.map((section) => (
          <CatalogSection
            title={section.title}
            collections={section.collections}
          />
        ))}
      </div>
    </section>

    <section
      class="domain-panel"
      data-domain-panel="media"
      aria-labelledby="media-title"
      hidden
    >
      <header class="domain-heading">
        <p class="eyebrow">March Jinn / Domain 02</p>
        <h1 id="media-title">Media</h1>
      </header>

      <div class="domain-catalog">
        <MediaCatalogNavigation />
      </div>
    </section>

  </div>

  <script>
    const panels = Array.from(
      document.querySelectorAll<HTMLElement>("[data-domain-panel]")
    );

    const navigationItems = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-domain]")
    );

    function renderDomain(domain: string) {
      const target = panels.find(
        (panel) => panel.dataset.domainPanel === domain
      );

      if (!target) return;

      panels.forEach((panel) => {
        panel.hidden = panel !== target;
      });

      navigationItems.forEach((button) => {
        const active = button.dataset.domain === domain;

        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });

      document.title =
        domain === "music"
          ? "March Jinn"
          : `${domain.charAt(0).toUpperCase()}${domain.slice(1)} — March Jinn`;
    }

    function selectDomain(domain: string, updateHistory = true) {
      if (!panels.some((panel) => panel.dataset.domainPanel === domain)) {
        return;
      }

      renderDomain(domain);

      try {
        localStorage.setItem("marchjinn-domain", domain);
      } catch {
        // The website remains functional without local storage.
      }

      if (updateHistory) {
        history.pushState(
          { ...history.state, domain },
          "",
          window.location.pathname
        );
      }
    }

    window.addEventListener("marchjinn:domain-change", (event) => {
      const customEvent = event as CustomEvent<{ domain: string }>;
      selectDomain(customEvent.detail.domain);
    });

    window.addEventListener("popstate", (event) => {
      let fallbackDomain = "music";

      try {
        fallbackDomain =
          localStorage.getItem("marchjinn-domain") || "music";
      } catch {
        // Use Music as the default domain.
      }

      selectDomain(event.state?.domain || fallbackDomain, false);
    });

    let initialDomain = "music";

    try {
      initialDomain =
        history.state?.domain ||
        localStorage.getItem("marchjinn-domain") ||
        "music";
    } catch {
      initialDomain = history.state?.domain || "music";
    }

    if (!panels.some((panel) => panel.dataset.domainPanel === initialDomain)) {
      initialDomain = "music";
    }

    renderDomain(initialDomain);

    history.replaceState(
      { ...history.state, domain: initialDomain },
      "",
      window.location.pathname
    );
  </script>
</SiteLayout>