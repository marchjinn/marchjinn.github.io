
---
import SiteLayout from "../layouts/SiteLayout.astro";

const domains = [
  {
    id: "music",
    label: "Music",
    number: "01",
    description: "The musical world of March Jinn.",
    sections: ["Releases", "Lives", "Credits"]
  },
  {
    id: "media",
    label: "Media",
    number: "02",
    description: "The complete media universe of March Jinn.",
    sections: ["Video", "Photography", "Audio", "Press"]
  },
  {
    id: "fashion",
    label: "Fashion",
    number: "03",
    description: "March Jinn across fashion and style.",
    sections: ["Collections", "Collaborations", "Projects"]
  },
  {
    id: "beauty",
    label: "Beauty",
    number: "04",
    description: "Beauty, grooming and personal aesthetics.",
    sections: ["Products", "Collaborations", "Projects"]
  },
  {
    id: "food-beverage",
    label: "Food & Beverage",
    number: "05",
    description: "Food, beverage and culinary culture.",
    sections: ["Products", "Collaborations", "Experiences"]
  },
  {
    id: "technology",
    label: "Technology",
    number: "06",
    description: "Technology, digital products and innovation.",
    sections: ["Products", "Projects", "Collaborations"]
  }
];
---

<SiteLayout
  title="March Jinn"
  description="March Jinn Official Website"
>
  <section class="platform-home" aria-label="March Jinn Digital Platform">
    <div class="platform-home__intro">
      <p class="eyebrow" id="domain-number">March Jinn / Domain 01</p>
      <h1 id="domain-title">Music</h1>
      <p id="domain-description">The musical world of March Jinn.</p>
    </div>

    <div class="domain-content" id="domain-content">
      <div class="domain-content__header">
        <span class="eyebrow">Explore</span>
      </div>
      <div class="domain-content__sections" id="domain-sections">
        {domains[0].sections.map((section) => (
          <div class="domain-content__item">
            <span>{section}</span>
            <span aria-hidden="true">↗</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script define:vars={{ domains }}>
    const domainNumber = document.querySelector("#domain-number");
    const domainTitle = document.querySelector("#domain-title");
    const domainDescription = document.querySelector("#domain-description");
    const domainSections = document.querySelector("#domain-sections");

    function renderDomain(domainId) {
      const domain = domains.find((item) => item.id === domainId);
      if (!domain) return;

      domainNumber.textContent = `March Jinn / Domain ${domain.number}`;
      domainTitle.textContent = domain.label;
      domainDescription.textContent = domain.description;

      domainSections.replaceChildren();

      domain.sections.forEach((section) => {
        const item = document.createElement("div");
        item.className = "domain-content__item";

        const label = document.createElement("span");
        label.textContent = section;

        const indicator = document.createElement("span");
        indicator.textContent = "↗";
        indicator.setAttribute("aria-hidden", "true");

        item.append(label, indicator);
        domainSections.append(item);
      });

      document.querySelectorAll(".global-nav__item").forEach((button) => {
        const active = button.dataset.domain === domainId;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });

      document.title = domainId === "music"
        ? "March Jinn"
        : `${domain.label} — March Jinn`;
    }

    function selectDomain(domainId, updateHistory = true) {
      const domain = domains.find((item) => item.id === domainId);
      if (!domain) return;

      renderDomain(domainId);
      localStorage.setItem("marchjinn-domain", domainId);

      if (updateHistory) {
        history.pushState(
          { domain: domainId },
          "",
          window.location.pathname
        );
      }
    }

    window.addEventListener("marchjinn:domain-change", (event) => {
      selectDomain(event.detail.domain);
    });

    window.addEventListener("popstate", (event) => {
      const domainId =
        event.state?.domain ||
        localStorage.getItem("marchjinn-domain") ||
        "music";

      selectDomain(domainId, false);
    });

    const initialDomain =
      history.state?.domain ||
      localStorage.getItem("marchjinn-domain") ||
      "music";

    renderDomain(initialDomain);
    history.replaceState(
      { ...history.state, domain: initialDomain },
      "",
      window.location.pathname
    );
  </script>
</SiteLayout>
