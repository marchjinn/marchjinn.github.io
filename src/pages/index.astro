---
import SiteLayout from "../layouts/SiteLayout.astro";

const domains = [
  {
    id: "music",
    label: "Music",
    number: "01",
    description: "The musical world of March Jinn.",
    sections: ["Releases", "Lives", "Credits"]
  },
  {
    id: "media",
    label: "Media",
    number: "02",
    description: "The complete media universe of March Jinn.",
    sections: ["Videos", "Photos", "Audios", "Streams", "Publications"]
  }
];
---

<SiteLayout
  title="March Jinn"
  description="March Jinn Official Website"
>
  <section class="platform-home" aria-label="March Jinn Digital Environment">
    <div class="platform-home__intro">
      <p class="eyebrow" id="domain-number">
        March Jinn / Domain 01
      </p>

      <h1 id="domain-title">Music</h1>

      <p
        class="platform-home__description"
        id="domain-description"
      >
        The musical world of March Jinn.
      </p>
    </div>

    <section class="domain-content" aria-label="Domain collections">
      <div class="domain-content__header">
        <p class="eyebrow">Explore</p>
      </div>

      <div
        class="domain-content__sections"
        id="domain-sections"
      >
        {domains[0].sections.map((section, index) => (
          <div class="domain-content__item">
            <span>{section}</span>
            <span aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
          </div>
        ))}
      </div>
    </section>
  </section>

  <script define:vars={{ domains }}>
    const domainNumber = document.querySelector("#domain-number");
    const domainTitle = document.querySelector("#domain-title");
    const domainDescription = document.querySelector("#domain-description");
    const domainSections = document.querySelector("#domain-sections");

    function renderDomain(domainId) {
      const domain = domains.find((item) => item.id === domainId);

      if (!domain) return;

      domainNumber.textContent =
        `March Jinn / Domain ${domain.number}`;

      domainTitle.textContent = domain.label;
      domainDescription.textContent = domain.description;

      domainSections.replaceChildren();

      domain.sections.forEach((section, index) => {
        const item = document.createElement("div");
        item.className = "domain-content__item";

        const label = document.createElement("span");
        label.textContent = section;

        const number = document.createElement("span");
        number.textContent = String(index + 1).padStart(2, "0");
        number.setAttribute("aria-hidden", "true");

        item.append(label, number);
        domainSections.append(item);
      });

      document.querySelectorAll("[data-domain]").forEach((button) => {
        const active = button.dataset.domain === domainId;

        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });

      document.title =
        domainId === "music"
          ? "March Jinn"
          : `${domain.label} — March Jinn`;
    }

    function selectDomain(domainId, updateHistory = true) {
      const domain = domains.find((item) => item.id === domainId);

      if (!domain) return;

      renderDomain(domainId);

      try {
        localStorage.setItem("marchjinn-domain", domainId);
      } catch {
        // The interface remains functional if storage is unavailable.
      }

      if (updateHistory) {
        history.pushState(
          { domain: domainId },
          "",
          window.location.pathname
        );
      }
    }

    window.addEventListener("marchjinn:domain-change", (event) => {
      selectDomain(event.detail.domain);
    });

    window.addEventListener("popstate", (event) => {
      let savedDomain = "music";

      try {
        savedDomain = localStorage.getItem("marchjinn-domain") || "music";
      } catch {
        // Use the default domain.
      }

      const domainId = event.state?.domain || savedDomain;

      selectDomain(domainId, false);
    });

    let initialDomain = "music";

    try {
      initialDomain =
        history.state?.domain ||
        localStorage.getItem("marchjinn-domain") ||
        "music";
    } catch {
      initialDomain = history.state?.domain || "music";
    }

    if (!domains.some((item) => item.id === initialDomain)) {
      initialDomain = "music";
    }

    renderDomain(initialDomain);

    history.replaceState(
      { ...history.state, domain: initialDomain },
      "",
      window.location.pathname
    );
  </script>
</SiteLayout>