
---
type CatalogFormat = "square" | "wide" | "portrait";

interface CatalogItem {
  title: string;
  year?: string;
  href: string;
  image?: string;
}

interface Collection {
  title: string;
  format?: CatalogFormat;
  items?: CatalogItem[];
}

interface Props {
  title: string;
  collections: Collection[];
  showTitle?: boolean;
}

const {
  title,
  collections,
  showTitle = true
} = Astro.props;
---

<section class="catalog-section" aria-label={title}>
  {showTitle && (
    <h2 class="catalog-section__title">{title}</h2>
  )}

  <div class="catalog-section__collections">
    {collections.map((collection) => (
      <section
        class="catalog-collection"
        data-format={collection.format ?? "square"}
        aria-label={collection.title}
      >
        <div class="catalog-collection__heading">
          <h3>{collection.title}</h3>
        </div>

        {collection.items && collection.items.length > 0 ? (
          <div class="catalog-shelf">
            <div class="catalog-shelf__track">
              {collection.items.map((item) => (
                <a class="catalog-card" href={item.href}>
                  <div class="catalog-card__media">
                    {item.image ? (
                      <img
                        src={item.image}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                    ) : (
                      <span class="catalog-card__placeholder"></span>
                    )}
                  </div>

                  <div class="catalog-card__information">
                    <span class="catalog-card__title">
                      {item.title}
                    </span>

                    {item.year && (
                      <span class="catalog-card__year">
                        {item.year}
                      </span>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </div>
        ) : (
          <p class="catalog-collection__empty">
            No published items
          </p>
        )}
      </section>
    ))}
  </div>
</section>

<style>
  @media (hover: hover) and (pointer: fine) {
    .catalog-shelf {
      cursor: grab;
    }

    .catalog-shelf.is-dragging {
      cursor: grabbing;
      user-select: none;
      -webkit-user-select: none;
      scroll-snap-type: none;
    }

    .catalog-shelf.is-dragging .catalog-card {
      pointer-events: none;
    }
  }
</style>

<script>
  let dragState: {
    shelf: HTMLElement;
    startX: number;
    startScrollLeft: number;
    moved: boolean;
  } | null = null;

  let suppressClickShelf: HTMLElement | null = null;

  // Vertical mouse wheel moves the horizontal catalog.
  document.addEventListener(
    "wheel",
    (event) => {
      if (!(event.target instanceof Element)) return;

      const shelf = event.target.closest<HTMLElement>(
        ".catalog-shelf"
      );

      if (!shelf) return;

      if (shelf.scrollWidth <= shelf.clientWidth) return;

      // Preserve native horizontal trackpad scrolling.
      if (Math.abs(event.deltaX) > Math.abs(event.deltaY)) return;

      const previousPosition = shelf.scrollLeft;
      const nextPosition = previousPosition + event.deltaY;

      const maxPosition = shelf.scrollWidth - shelf.clientWidth;

      const boundedPosition = Math.max(
        0,
        Math.min(maxPosition, nextPosition)
      );

      if (boundedPosition === previousPosition) return;

      event.preventDefault();
      shelf.scrollLeft = boundedPosition;
    },
    { passive: false }
  );

  // Start mouse dragging.
  document.addEventListener("pointerdown", (event) => {
    suppressClickShelf = null;

    if (event.pointerType !== "mouse" || event.button !== 0) return;

    if (!(event.target instanceof Element)) return;

    const shelf = event.target.closest<HTMLElement>(
      ".catalog-shelf"
    );

    if (!shelf || shelf.scrollWidth <= shelf.clientWidth) return;

    dragState = {
      shelf,
      startX: event.clientX,
      startScrollLeft: shelf.scrollLeft,
      moved: false
    };
  });

  // Move the shelf while dragging.
  document.addEventListener("pointermove", (event) => {
    if (!dragState || event.pointerType !== "mouse") return;

    const distance = event.clientX - dragState.startX;

    if (Math.abs(distance) > 5) {
      dragState.moved = true;
    }

    if (!dragState.moved) return;

    event.preventDefault();

    dragState.shelf.classList.add("is-dragging");

    dragState.shelf.scrollLeft =
      dragState.startScrollLeft - distance;
  });

  // Finish dragging.
  document.addEventListener("pointerup", () => {
    if (!dragState) return;

    if (dragState.moved) {
      suppressClickShelf = dragState.shelf;
    }

    dragState.shelf.classList.remove("is-dragging");

    dragState = null;
  });

  document.addEventListener("pointercancel", () => {
    if (!dragState) return;

    dragState.shelf.classList.remove("is-dragging");

    dragState = null;
    suppressClickShelf = null;
  });

  // Prevent accidental card navigation after dragging.
  document.addEventListener(
    "click",
    (event) => {
      if (!suppressClickShelf) return;

      if (!(event.target instanceof Element)) return;

      const clickedShelf = event.target.closest(".catalog-shelf");

      if (clickedShelf !== suppressClickShelf) return;

      event.preventDefault();
      event.stopImmediatePropagation();

      suppressClickShelf = null;
    },
    true
  );
</script>
