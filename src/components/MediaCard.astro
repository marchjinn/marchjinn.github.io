
---
import type { MediaItem } from "../content/media";

interface Props {
  item: MediaItem;
  embedUrl?: string;
}

const { item, embedUrl } = Astro.props;

const parsedDate = item.publishedAt
  ? new Date(item.publishedAt)
  : undefined;

const dateLabel =
  parsedDate && !Number.isNaN(parsedDate.getTime())
    ? parsedDate.getFullYear()
    : undefined;

const allowedEmbedHosts = [
  "www.youtube-nocookie.com",
  "player.vimeo.com",
  "open.spotify.com",
  "player.twitch.tv"
];

let safeEmbedUrl: string | undefined;

if (embedUrl) {
  try {
    const parsedUrl = new URL(embedUrl);

    if (
      parsedUrl.protocol === "https:" &&
      allowedEmbedHosts.includes(parsedUrl.hostname)
    ) {
      safeEmbedUrl = parsedUrl.toString();
    }
  } catch {
    safeEmbedUrl = undefined;
  }
}
---

<article class="catalog-card media-card">
  <div class="catalog-card__media">
    {item.thumbnail ? (
      <img
        src={item.thumbnail}
        alt=""
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span class="catalog-card__placeholder"></span>
    )}

    <div
      class="media-card__player"
      data-media-player
      hidden
    ></div>
  </div>

  <div class="catalog-card__information">
    <span class="catalog-card__title">{item.title}</span>

    {dateLabel && (
      <span class="catalog-card__year">{dateLabel}</span>
    )}

    {safeEmbedUrl ? (
      <button
        class="text-link media-card__action"
        type="button"
        data-media-play
        data-embed-url={safeEmbedUrl}
        data-title={item.title}
        aria-expanded="false"
      >
        Play
      </button>
    ) : (
      <a
        class="text-link media-card__action"
        href={item.sourceUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Open original
      </a>
    )}

    <a
      class="media-card__source"
      href={item.sourceUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Original source ↗
    </a>
  </div>
</article>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof Element)) return;

    const button = target.closest<HTMLButtonElement>(
      "[data-media-play]"
    );

    if (!button) return;

    const card = button.closest<HTMLElement>(".media-card");
    const player = card?.querySelector<HTMLElement>(
      "[data-media-player]"
    );

    if (!card || !player) return;

    const existingIframe = player.querySelector("iframe");

    if (existingIframe) {
      existingIframe.remove();
      player.hidden = true;

      button.setAttribute("aria-expanded", "false");
      button.textContent = "Play";

      return;
    }

    const embedUrl = button.dataset.embedUrl;

    if (!embedUrl) return;

    const iframe = document.createElement("iframe");

    iframe.src = embedUrl;
    iframe.title = button.dataset.title || "March Jinn media player";
    iframe.allow =
      "autoplay; encrypted-media; picture-in-picture; fullscreen";
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = "strict-origin-when-cross-origin";
    iframe.loading = "lazy";

    player.replaceChildren(iframe);
    player.hidden = false;

    button.setAttribute("aria-expanded", "true");
    button.textContent = "Stop";
  });
</script>

<style>
  .media-card {
    min-width: 0;
  }

  .media-card__player {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #000;
  }

  .media-card__player iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .media-card__action {
    width: fit-content;
    margin-top: 7px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-size: 12px;
  }

  .media-card__source {
    display: inline-block;
    width: fit-content;
    margin-top: 3px;
    color: var(--color-tertiary);
    font-size: 11px;
    transition: color var(--transition-fast);
  }

  .media-card__source:hover {
    color: var(--color-primary);
  }
</style>
