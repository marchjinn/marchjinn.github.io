
---
const domains = [
  { id: "music", label: "Music" },
  { id: "media", label: "Media" }
];
---

<nav class="global-nav" aria-label="Global navigation">
  <div class="global-nav__shell">
    <div class="global-nav__inner">
      <div class="global-nav__domains">
        {domains.map((domain) => (
          <button
            class:list={[
              "global-nav__item",
              domain.id === "music" && "is-active"
            ]}
            type="button"
            data-domain={domain.id}
            aria-pressed={domain.id === "music" ? "true" : "false"}
          >
            <span class="global-nav__item-label">{domain.label}</span>
            <span class="global-nav__item-indicator" aria-hidden="true"></span>
          </button>
        ))}
      </div>

      <a
        class="global-nav__brand"
        href="/"
        aria-label="March Jinn — Main environment"
      >
        <span class="global-nav__brand-mark" aria-hidden="true">FJ</span>
      </a>
    </div>
  </div>
</nav>

<script>
  const LAST_PAGE_KEYS = {
    music: "marchjinn-last-music-page",
    media: "marchjinn-last-media-page"
  };

  function getCurrentDomain() {
    const path = window.location.pathname;

    if (path === "/") {
      const visiblePanel = document.querySelector<HTMLElement>(
        "[data-domain-panel]:not([hidden])"
      );

      return visiblePanel?.dataset.domainPanel || "music";
    }

    const domainPage = document.querySelector<HTMLElement>(
      "[data-domain-page]"
    );

    if (domainPage?.dataset.domainPage) {
      return domainPage.dataset.domainPage;
    }

    if (path === "/music/") return "music";
    if (path === "/media/") return "media";

    return "music";
  }

  function syncActiveDomain() {
    const activeDomain = getCurrentDomain();

    document.querySelectorAll<HTMLButtonElement>("[data-domain]").forEach(
      (button) => {
        const active = button.dataset.domain === activeDomain;

        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      }
    );

    try {
      localStorage.setItem("marchjinn-domain", activeDomain);
      localStorage.setItem(
        LAST_PAGE_KEYS[activeDomain as keyof typeof LAST_PAGE_KEYS],
        window.location.pathname
      );
    } catch {
      // Navigation remains functional without local storage.
    }
  }

  document.addEventListener("astro:page-load", syncActiveDomain);
  syncActiveDomain();

  document.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof Element)) return;

    const button = target.closest<HTMLButtonElement>("[data-domain]");

    if (!button) return;

    const selectedDomain = button.dataset.domain;

    if (
      selectedDomain !== "music" &&
      selectedDomain !== "media"
    ) {
      return;
    }

    const currentPath = window.location.pathname;

    if (currentPath === "/") {
      window.dispatchEvent(
        new CustomEvent("marchjinn:domain-change", {
          detail: { domain: selectedDomain }
        })
      );

      syncActiveDomain();
      return;
    }

    const currentDomain = getCurrentDomain();

    if (currentDomain === selectedDomain) return;

    const storageKey = LAST_PAGE_KEYS[
      selectedDomain as keyof typeof LAST_PAGE_KEYS
    ];

    const fallbackPath =
      selectedDomain === "music" ? "/" : "/media/";

    let destination = fallbackPath;

    try {
      const savedPath = localStorage.getItem(storageKey);

      if (savedPath && savedPath.startsWith("/")) {
        destination = savedPath;
      }

      localStorage.setItem("marchjinn-domain", selectedDomain);
    } catch {
      // Use the default destination without local storage.
    }

    if (destination === "/") {
      history.replaceState(
        { ...history.state, domain: selectedDomain },
        "",
        currentPath
      );
    }

    if (destination !== currentPath) {
      window.location.replace(destination);
    }
  });
</script>
