
---
const domains = [
  { id: "music", label: "Music" },
  { id: "media", label: "Media" },
  { id: "fashion", label: "Fashion" },
  { id: "beauty", label: "Beauty" },
  { id: "food-beverage", label: "Food & Beverage" },
  { id: "technology", label: "Technology" }
];
---

<nav class="global-nav" aria-label="Global navigation">
  <div class="global-nav__inner">

    {domains.slice(0, 3).map((domain) => (
      <button
        class="global-nav__item"
        type="button"
        data-domain={domain.id}
        aria-pressed={domain.id === "music" ? "true" : "false"}
      >
        {domain.label}
      </button>
    ))}

    <a class="global-nav__brand" href="/" aria-label="Fire Jinn — March Jinn main environment">
      <span>Fire Jinn</span>
    </a>

    {domains.slice(3).map((domain) => (
      <button
        class="global-nav__item"
        type="button"
        data-domain={domain.id}
        aria-pressed="false"
      >
        {domain.label}
      </button>
    ))}

  </div>
</nav>

<script>
  function initialiseGlobalNav() {
    const nav = document.querySelector(".global-nav");
    if (!nav || nav.dataset.initialised === "true") return;

    nav.dataset.initialised = "true";
    const buttons = nav.querySelectorAll("[data-domain]");

    function setActiveDomain(domainId) {
      buttons.forEach((button) => {
        const active = button.getAttribute("data-domain") === domainId;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const selectedDomain = button.getAttribute("data-domain");

        setActiveDomain(selectedDomain);

        window.dispatchEvent(
          new CustomEvent("marchjinn:domain-change", {
            detail: { domain: selectedDomain }
          })
        );
      });
    });

    window.addEventListener("marchjinn:domain-change", (event) => {
      setActiveDomain(event.detail?.domain);
    });

    const path = window.location.pathname;

    if (path.startsWith("/media")) setActiveDomain("media");
    else if (path.startsWith("/music")) setActiveDomain("music");
  }

  document.addEventListener("astro:page-load", initialiseGlobalNav);
  initialiseGlobalNav();
</script>
