---
const domains = [
  { id: "music", label: "Music" },
  { id: "media", label: "Media" }
];
---

<nav class="global-nav" aria-label="Global navigation">
  <div class="global-nav__shell">
    <div class="global-nav__inner">
      <div class="global-nav__domains">
        {domains.map((domain) => (
          <button
            class:list={[
              "global-nav__item",
              domain.id === "music" && "is-active"
            ]}
            type="button"
            data-domain={domain.id}
            aria-pressed={domain.id === "music" ? "true" : "false"}
          >
            <span class="global-nav__item-label">{domain.label}</span>
            <span class="global-nav__item-indicator" aria-hidden="true"></span>
          </button>
        ))}
      </div>

      <a
        class="global-nav__brand"
        href="/"
        aria-label="March Jinn — Main environment"
      >
        <span class="global-nav__brand-mark" aria-hidden="true">FJ</span>
      </a>
    </div>
  </div>
</nav>

<script>
  function syncActiveDomain() {
    const path = window.location.pathname;

    const isMusic =
      path === "/" ||
      path.startsWith("/music/") ||
      path.startsWith("/zillion/");

    const activeDomain = isMusic ? "music" : "media";

    document.querySelectorAll<HTMLButtonElement>("[data-domain]").forEach(
      (button) => {
        const active = button.dataset.domain === activeDomain;

        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      }
    );
  }

  document.addEventListener("astro:page-load", syncActiveDomain);
  syncActiveDomain();

  document.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof Element)) return;

    const button = target.closest<HTMLButtonElement>("[data-domain]");

    if (!button) return;

    const selectedDomain = button.dataset.domain;

    if (!selectedDomain) return;

    if (window.location.pathname === "/") {
      window.dispatchEvent(
        new CustomEvent("marchjinn:domain-change", {
          detail: { domain: selectedDomain }
        })
      );

      syncActiveDomain();
      return;
    }

    const destination =
      selectedDomain === "media" ? "/media/" : "/";

    if (window.location.pathname !== destination) {
      window.location.assign(destination);
    }
  });
</script>