---
import { mediaSections } from "../content/media";
---

<div class="media-catalog-navigation">
  {mediaSections.map((section) => (
    <section class="media-catalog-section" aria-label={section.title}>
      <h2 class="media-catalog-section__title">
        {section.title}
      </h2>

      <nav class="media-catalog-section__links" aria-label={`${section.title} categories`}>
        {section.categories.map((category) => (
          <a
            class="media-category-link"
            href={`/${category.slug}/`}
          >
            <span>{category.title}</span>
            <span class="media-category-link__arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
    </section>
  ))}
</div>

<style>
  .media-catalog-navigation {
    display: flex;
    flex-direction: column;
    gap: clamp(38px, 5vw, 64px);
  }

  .media-catalog-section {
    min-width: 0;
  }

  .media-catalog-section__title {
    margin: 0 0 18px;
    color: var(--color-primary);
    font-size: clamp(22px, 2.5vw, 30px);
    font-weight: 500;
    letter-spacing: -0.045em;
  }

  .media-catalog-section__links {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding: 2px 0 12px;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  .media-catalog-section__links::-webkit-scrollbar {
    display: none;
  }

  .media-category-link {
    display: inline-flex;
    flex: 0 0 auto;
    min-height: 44px;
    align-items: center;
    gap: 14px;
    padding: 10px 15px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-small);
    color: var(--color-secondary);
    background: var(--color-surface);
    font-size: 12px;
    font-weight: 500;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .media-category-link:hover {
    color: var(--color-primary);
    border-color: var(--color-secondary);
  }

  .media-category-link__arrow {
    color: var(--color-tertiary);
    transition: transform var(--transition-fast);
  }

  .media-category-link:hover .media-category-link__arrow {
    transform: translate(2px, -2px);
  }
</style>